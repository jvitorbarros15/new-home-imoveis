# Public browser configuration. v1/config.js is generated from these at build
# time, so no project identifiers are committed to the repository.
# Only the public anonymous key belongs here. A service-role key must never
# reach the browser or this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Cloudflare Turnstile site key. Optional: when set, the admin login renders a
# challenge and Supabase Auth verifies it server-side. Enable Turnstile under
# Authentication > Attack Protection with the matching secret key.
TURNSTILE_SITE_KEY=

# Absolute site origin, used by api/imovel.js when building canonical and
# Open Graph URLs.
SITE_URL=https://new-home-imoveis.vercel.app
