# Public browser configuration. v1/config.js is generated from these at build
# time, so no project identifiers are committed to the repository.
# Only the public anonymous key belongs here. A service-role key must never
# reach the browser or this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Cloudflare Turnstile site key. Optional: when set, the admin login renders a
# challenge and Supabase Auth verifies it server-side. Enable Turnstile under
# Authentication > Attack Protection with the matching secret key.
TURNSTILE_SITE_KEY=

# Absolute site origin, used by api/imovel.js when building canonical and
# Open Graph URLs.
SITE_URL=https://new-home-imoveis.vercel.app

# Lead pipeline (api/lead.js). Server-side only: set these in the Vercel project
# environment, never in the browser and never committed.
# SERVER ONLY: the service-role key bypasses Row Level Security. Do not expose
# it to the browser, do not prefix it for client bundles, do not commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
# Turnstile secret matching TURNSTILE_SITE_KEY. Required in production.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Resend notification email for each new lead. Optional.
RESEND_API_KEY=re_your-resend-api-key
LEAD_NOTIFY_TO=team@example.com
LEAD_NOTIFY_FROM=New Home <onboarding@resend.dev>
